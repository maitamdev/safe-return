# SafeReturn - Vercel environment template
# Paste the variables below into Vercel, then replace every CHANGE_ME value.

# Public application URL (required in Production)
NEXT_PUBLIC_SITE_URL=https://CHANGE_ME.vercel.app

# Solana Devnet (public)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_LIVE=1
NEXT_PUBLIC_FINDBACK_PROGRAM_ID=3hLzzJDHvbuKFPKweKEJ3ZAQEijoLLejkvi9ZPmByWna
NEXT_PUBLIC_FIND_MINT=9F6hBVk5V6HgdcRCsgApoGLU2n68qTYjHKESBoCKRmCy
NEXT_PUBLIC_ARBITER=DoNrsajZ2Yo8C1biPb8BiB2z3S5ZwZ9VWuFMwF8R2CUa

# Supabase browser credentials (required, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME

# Supabase server credential (required, secret, never prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# Server signer for Devnet funding/arbitration (required, secret)
# Use the complete JSON number array from the arbiter id.json file.
# Its public key must match NEXT_PUBLIC_ARBITER.
SOLANA_KEYPAIR_JSON=CHANGE_ME

# Live AI review. Without a valid key, AI review is unavailable and no fallback result is generated.
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
