# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Solana local secrets
.program-id
.deployer-pubkey
**/id.json
target/deploy/*-keypair.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Anchor / Solana build (the generated IDL is a reviewed client contract)
/target/*
!/target/idl/
!/target/idl/**
/test-ledger/
test-ledger*
*.log
*.log.err
.anchor
**/*.rs.bk
**/keypair.json
**/*-keypair.json

.vercel
